<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- iOS 14+ pide permiso para hablar con equipos de la red local (el Mac con ORDS). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>USBrain se conecta al servidor de desarrollo en tu red local.</string>
	<!-- Permite HTTP solo hacia la red local (ORDS en Docker durante el desarrollo). -->
	<!-- Texto que iOS muestra al pedir Face ID para desbloquear la app. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Usa Face ID para desbloquear USBrain sin escribir tu PIN.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>