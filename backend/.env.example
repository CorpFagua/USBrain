# Copia este archivo como backend/.env (install.sh lo crea solo si no existe).
# backend/.env NO se versiona.

# Contenedor de Oracle Database (la contraseña de SYS se lee de su variable ORACLE_PWD).
ORACLE_CONTAINER=oracle-db
ORACLE_SERVICE=FREEPDB1

# Contraseña del esquema de la aplicación (USBRAIN). install.sh genera una aleatoria.
USBRAIN_DB_PASSWORD=

# Contraseña de los usuarios de prueba que crea 90_seed_dev.sql (solo desarrollo).
DEV_SEED_PASSWORD=

# URL base de la API (para las pruebas).
API_BASE=http://localhost:8080/ords/usbrain/v1

# Acceso a APEX (http://localhost:8080/ords/apex) · workspace USBRAIN. install.sh --seed la genera.
APEX_DEV_USER=dev
APEX_DEV_PASSWORD=
