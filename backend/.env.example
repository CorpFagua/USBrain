# Copia este archivo como backend/.env y completa lo que corresponda a tu caso.
# backend/.env NO se versiona. install.sh genera las contraseñas que dejes vacías.

# ----------------------------------------------------------------------------
# ¿Dónde está tu Oracle?
#   docker → los contenedores de backend/docker-compose.yml (o los tuyos, por nombre)
#   local  → un Oracle/ORDS/APEX que ya tienes instalado (en tu máquina u otro Docker);
#            install.sh se conecta con SQLcl (sql) o sqlplus usando host, puerto y servicio.
# ----------------------------------------------------------------------------
ORACLE_MODE=docker

# Contraseña de SYS. En modo docker con docker-compose.yml es la que crea la base.
# Mínimo 8 caracteres con mayúscula, minúscula y número (ej.: OracleApex2026).
# Si tu contenedor ya existe y tiene la variable ORACLE_PWD, puedes dejarla vacía.
ORACLE_PWD=

# Contraseña de APEX_PUBLIC_USER. Opcional en desarrollo: por defecto usa ORACLE_PWD.
APEX_PWD=

# Base enchufable donde vive la app (FREEPDB1 en Oracle Free 23ai/26ai).
ORACLE_SERVICE=FREEPDB1

# --- modo docker ---
ORACLE_CONTAINER=oracle-db
ORDS_CONTAINER=ords

# --- modo local ---
DB_HOST=localhost
DB_PORT=1521
# Cliente SQL: sql (SQLcl) o sqlplus, en el PATH.
SQL_CLIENT=sql

# Puerto de ORDS en tu máquina (docker-compose.yml lo publica aquí).
ORDS_PORT=8080

# Contraseña del esquema de la aplicación (USBRAIN). install.sh genera una aleatoria.
USBRAIN_DB_PASSWORD=

# Contraseña de los usuarios de demostración que crea 90_seed_dev.sql (solo desarrollo).
DEV_SEED_PASSWORD=

# URL base de la API (para las pruebas). Cambia el puerto si tu ORDS no usa el 8080.
API_BASE=http://localhost:8080/ords/usbrain/v1

# Acceso a APEX (http://localhost:8080/ords/apex) · workspace USBRAIN. install.sh --seed la genera.
APEX_DEV_USER=dev
APEX_DEV_PASSWORD=

# Stage (Render + ngrok): dominio fijo de tu cuenta de ngrok. Ver STAGE.md.
NGROK_DOMAIN=slinging-overjoyed-landlord.ngrok-free.dev
